{
    "dependencies": {
        "mysql2": "^3.24.4",
        "xml-mapping": "^1.7.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/node": "^20.19.43",
        "eslint": "^10.11.0",
        "super-configs": "^1.25.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "description": "Modern CommonJS MySQL client with callbacks, Promises, named parameters, and isolated clients.",
    "engines": {
        "node": ">=20.19.0"
    },
    "keywords": [
        "mysql",
        "mysql-manager"
    ],
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "require": "./src/index.js",
            "default": "./src/index.js"
        }
    },
    "files": [
        "src"
    ],
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "maintainers": [
        {
            "name": "@pilmee"
        }
    ],
    "name": "@eljijuna/pilmee-mysql",
    "private": false,
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ElJijuna/pilmee-mysql.git"
    },
    "bugs": {
        "url": "https://github.com/ElJijuna/pilmee-mysql/issues"
    },
    "homepage": "https://github.com/ElJijuna/pilmee-mysql#readme",
    "type": "commonjs",
    "scripts": {
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node app",
        "test": "node --test",
        "typecheck": "tsc --project tsconfig.json"
    },
    "version": "2.0.0",
    "license": "MIT",
    "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)"
}
